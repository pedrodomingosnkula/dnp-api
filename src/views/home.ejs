<script>
document.getElementById('ano').textContent = new Date().getFullYear();

// Janela de código com digitação
const linhas = [
  '<span class="c">// perfil.ts</span>',
  '<span class="k">const</span> domingos = {',
  '  funcao: <span class="s">"Full-Stack"</span>,',
  '  local: <span class="s">"Luanda, Angola"</span>,',
  '  front: [<span class="s">"React"</span>, <span class="s">"TypeScript"</span>, <span class="s">"Tailwind"</span>],',
  '  back: [<span class="s">"Node.js"</span>, <span class="s">"Fastify"</span>, <span class="s">"PHP"</span>, <span class="s">"C#"</span>],',
  '  dados: [<span class="s">"PostgreSQL"</span>, <span class="s">"MongoDB"</span>],',
  '  estuda: <span class="s">"Engenharia Informática"</span>,',
  '  emEquipa: <span class="k">true</span>,',
  '  <span class="f">aprender</span>() { <span class="k">return</span> <span class="s">"sempre"</span>; }',
  '};'
];
const alvo = document.getElementById('typed');
const reduzido = matchMedia('(prefers-reduced-motion: reduce)').matches;
const caret = '<span class="caret"></span>';

if (reduzido) {
  alvo.innerHTML = linhas.join('\n');
} else {
  let i = 0, feito = '';
  (function proxima() {
    if (i >= linhas.length) { alvo.innerHTML = feito + caret; return; }
    const html = linhas[i];
    // digita o texto visível mantendo as tags intactas
    let pos = 0, buf = '';
    (function letra() {
      if (pos >= html.length) { feito += html + '\n'; i++; return setTimeout(proxima, 140); }
      if (html[pos] === '<') { pos = html.indexOf('>', pos) + 1; }
      else { pos++; }
      buf = html.slice(0, pos);
      // fecha spans abertos
      const abertos = (buf.match(/<span/g) || []).length - (buf.match(/<\/span>/g) || []).length;
      alvo.innerHTML = feito + buf + '</span>'.repeat(Math.max(0, abertos)) + caret;
      setTimeout(letra, 22);
    })();
  })();
}
</script>
