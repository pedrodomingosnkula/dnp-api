<!DOCTYPE html>
<html lang="pt-AO">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Domingos Pedro — Desenvolvedor Full-Stack</title>
<meta name="description" content="Portfólio de Domingos Pedro, desenvolvedor Full-Stack em Luanda, Angola.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500;12..96,700;12..96,800&family=DM+Sans:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
<style>
:root{
  --bg:#0d1022; --bg2:#141836; --card:#171b3d; --line:#2a3066;
  --text:#eceefb; --muted:#a3a9d4;
  --violet:#8b6bff; --gold:#ffc23d; --coral:#ff5d73;
  --display:'Bricolage Grotesque',system-ui,sans-serif;
  --body:'DM Sans',system-ui,sans-serif;
  --mono:'JetBrains Mono',ui-monospace,monospace;
}
*{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth}
body{background:var(--bg);color:var(--text);font:400 1.0625rem/1.65 var(--body);overflow-x:hidden}
a{color:inherit;text-decoration:none}
:focus-visible{outline:3px solid var(--gold);outline-offset:3px;border-radius:6px}
.wrap{width:min(1120px,100% - 2.5rem);margin-inline:auto}

/* fundo */
.glow{position:fixed;inset:0;z-index:-1;pointer-events:none;
  background:
   radial-gradient(40vw 40vw at 85% -5%,rgba(139,107,255,.35),transparent 70%),
   radial-gradient(35vw 35vw at -5% 45%,rgba(255,93,115,.16),transparent 70%),
   radial-gradient(30vw 30vw at 100% 85%,rgba(255,194,61,.12),transparent 70%)}

/* nav */
header{position:sticky;top:0;z-index:20;backdrop-filter:blur(14px);background:rgba(13,16,34,.65);border-bottom:1px solid rgba(42,48,102,.6)}
nav{display:flex;align-items:center;justify-content:space-between;height:68px}
.logo{font:800 1.25rem var(--display);letter-spacing:-.02em;display:flex;align-items:center;gap:.6rem}
.logo i{width:30px;height:30px;border-radius:9px;background:linear-gradient(135deg,var(--violet),var(--coral));display:grid;place-items:center;font:800 .9rem var(--display);font-style:normal;color:#fff}
nav ul{display:flex;gap:1.8rem;list-style:none;font-size:.95rem;color:var(--muted)}
nav ul a:hover{color:var(--text)}
.btn{display:inline-flex;align-items:center;gap:.5rem;padding:.8rem 1.4rem;border-radius:999px;font-weight:600;font-size:.98rem;transition:transform .2s,background .2s,border-color .2s}
.btn.main{background:var(--gold);color:#1a1300}
.btn.main:hover{transform:translateY(-2px);background:#ffd166}
.btn.ghost{border:1.5px solid var(--line);color:var(--text)}
.btn.ghost:hover{border-color:var(--violet);background:rgba(139,107,255,.12)}
@media(max-width:760px){nav ul{display:none}}

/* hero */
.hero{padding:clamp(3.5rem,9vw,7rem) 0 4rem;display:grid;grid-template-columns:1.15fr .85fr;gap:3rem;align-items:center}
.status{display:inline-flex;align-items:center;gap:.6rem;padding:.4rem .9rem;border:1px solid var(--line);border-radius:999px;font-size:.88rem;color:var(--muted);background:rgba(23,27,61,.6)}
.status b{width:9px;height:9px;border-radius:50%;background:#3ddc97;box-shadow:0 0 0 0 rgba(61,220,151,.6);animation:pulse 2s infinite}
@keyframes pulse{70%{box-shadow:0 0 0 9px rgba(61,220,151,0)}100%{box-shadow:0 0 0 0 rgba(61,220,151,0)}}
h1{font:800 clamp(2.9rem,7.4vw,5.9rem)/.95 var(--display);letter-spacing:-.045em;margin:1.4rem 0 1.4rem}
h1 span{display:block;background:linear-gradient(95deg,var(--violet) 10%,var(--coral) 55%,var(--gold));-webkit-background-clip:text;background-clip:text;color:transparent}
.lead{max-width:34rem;color:var(--muted);font-size:1.15rem}
.cta{display:flex;flex-wrap:wrap;gap:.9rem;margin-top:2rem}
.hero > div:first-child > *{animation:rise .8s cubic-bezier(.2,.7,.2,1) both}
.hero > div:first-child > :nth-child(2){animation-delay:.1s}
.hero > div:first-child > :nth-child(3){animation-delay:.2s}
.hero > div:first-child > :nth-child(4){animation-delay:.3s}
@keyframes rise{from{opacity:0;transform:translateY(22px)}}

/* janela de código */
.code{background:#0a0c1c;border:1px solid var(--line);border-radius:18px;box-shadow:0 30px 80px -20px rgba(139,107,255,.45);overflow:hidden;transform:rotate(1.6deg)}
.code .bar{display:flex;gap:7px;align-items:center;padding:.8rem 1rem;background:var(--bg2);border-bottom:1px solid var(--line);font:500 .78rem var(--mono);color:var(--muted)}
.code .bar i{width:11px;height:11px;border-radius:50%;background:var(--coral)}
.code .bar i:nth-child(2){background:var(--gold)}
.code .bar i:nth-child(3){background:#3ddc97}
.code .bar span{margin-left:.6rem}
.code pre{padding:1.3rem 1.3rem 1.5rem;font:400 .86rem/1.75 var(--mono);min-height:330px;white-space:pre-wrap;color:#cfd3f5}
.k{color:#c4a8ff}.s{color:#ffd98a}.f{color:#ff8fa0}.c{color:#6a72a8}
.caret{display:inline-block;width:8px;height:1em;background:var(--gold);vertical-align:-2px;animation:blink 1s steps(1) infinite}
@keyframes blink{50%{opacity:0}}
@media(max-width:900px){.hero{grid-template-columns:1fr}.code{transform:none}}

/* seções */
section{padding:4.5rem 0}
h2{font:800 clamp(2rem,4.5vw,3.2rem)/1.05 var(--display);letter-spacing:-.035em;margin-bottom:.8rem}
.sub{color:var(--muted);max-width:38rem;margin-bottom:2.6rem}

/* sobre */
.about{display:grid;grid-template-columns:1fr 1fr;gap:3rem;align-items:start}
.about p+p{margin-top:1rem}
.about p{color:#c9cdee}
.facts{display:grid;gap:.9rem}
.fact{display:flex;gap:1rem;align-items:center;padding:1.1rem 1.3rem;background:var(--card);border:1px solid var(--line);border-radius:16px}
.fact svg{flex:none;width:26px;height:26px;stroke:var(--gold);fill:none;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round}
.fact small{display:block;color:var(--muted);font-size:.85rem}
@media(max-width:820px){.about{grid-template-columns:1fr}}

/* competências */
.skills{display:grid;grid-template-columns:repeat(6,1fr);gap:1rem}
.box{background:var(--card);border:1px solid var(--line);border-radius:22px;padding:1.6rem;grid-column:span 2;transition:border-color .25s}
.box:hover{border-color:var(--violet)}
.box.wide{grid-column:span 3}
.box h3{font:700 1.2rem var(--display);margin-bottom:1rem;display:flex;align-items:center;gap:.7rem}
.box h3 i{width:12px;height:12px;border-radius:4px;background:var(--c,var(--violet))}
.tags{display:flex;flex-wrap:wrap;gap:.5rem}
.tags span{padding:.32rem .8rem;border-radius:999px;background:rgba(139,107,255,.12);border:1px solid rgba(139,107,255,.28);font-size:.88rem}
@media(max-width:900px){.box,.box.wide{grid-column:span 6}}
@media(min-width:901px) and (max-width:1020px){.box{grid-column:span 3}}

/* experiência */
.timeline{position:relative;display:grid;gap:1.2rem;padding-left:2rem}
.timeline::before{content:"";position:absolute;left:7px;top:8px;bottom:8px;width:2px;background:linear-gradient(var(--violet),var(--coral),var(--line))}
.job{position:relative;background:var(--card);border:1px solid var(--line);border-radius:20px;padding:1.5rem 1.7rem}
.job::before{content:"";position:absolute;left:calc(-2rem + 1px);top:1.9rem;width:14px;height:14px;border-radius:50%;background:var(--bg);border:3px solid var(--violet)}
.job.now::before{border-color:var(--gold);background:var(--gold)}
.job .when{font:500 .82rem var(--mono);color:var(--gold)}
.job h3{font:700 1.3rem var(--display);margin:.3rem 0 .15rem}
.job .org{color:var(--muted);font-size:.95rem;margin-bottom:.8rem}
.job ul{padding-left:1.1rem;color:#c9cdee;font-size:.98rem}
.job li+li{margin-top:.35rem}

/* formação */
.edu{display:grid;grid-template-columns:1fr 1fr;gap:1.2rem}
.panel{background:var(--card);border:1px solid var(--line);border-radius:22px;padding:1.8rem}
.panel h3{font:700 1.25rem var(--display);margin-bottom:1.2rem}
.item+.item{margin-top:1.1rem;padding-top:1.1rem;border-top:1px dashed var(--line)}
.item b{display:block;font-weight:600}
.item small{color:var(--muted);font-size:.9rem}
@media(max-width:820px){.edu{grid-template-columns:1fr}}

/* contacto */
.contact{text-align:center;background:linear-gradient(135deg,rgba(139,107,255,.25),rgba(255,93,115,.18));border:1px solid var(--line);border-radius:32px;padding:clamp(2.5rem,7vw,5rem) 1.5rem}
.contact h2{font-size:clamp(2.2rem,6vw,4.2rem)}
.contact p{color:var(--muted);max-width:32rem;margin:0 auto 2rem}
.contact .cta{justify-content:center}
.phones{margin-top:1.6rem;font:500 .95rem var(--mono);color:var(--muted)}
footer{padding:2.5rem 0 3rem;text-align:center;color:var(--muted);font-size:.9rem}

@media(prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important;scroll-behavior:auto!important}}
</style>
</head>
